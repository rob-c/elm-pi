{
  "permission": {
    "*": "allow",
    "subagent": "allow",
    "bg_wait": "allow",
    "subagent_supervisor": "allow",
    "contact_supervisor": "allow",
    "external_directory": {
      "*": "ask",
      "~/.cache/elm-pi/worktrees/**": "allow",
      "/var/folders/*/*/T/pi-subagents-uid-*/**": "allow",
      "/private/var/folders/*/*/T/pi-subagents-uid-*/**": "allow",
      "/tmp/pi-subagents-uid-*/**": "allow",
      "/private/tmp/pi-subagents-uid-*/**": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.git/*": "deny",
      ".git/*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gh/*": "deny",
      "*.pem": "deny",
      "*id_rsa*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "git push*": "ask",
      "git remote add*": "ask",
      "gh *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "sftp *": "ask"
    }
  },
  "piInfrastructureReadPaths": [
    "@AGENT_DIR@/**",
    "/var/folders/*/*/T/pi-subagents-uid-*/**",
    "/private/var/folders/*/*/T/pi-subagents-uid-*/**",
    "/tmp/pi-subagents-uid-*/**",
    "/private/tmp/pi-subagents-uid-*/**",
    "~/.cache/elm-pi/**"
  ]
}
