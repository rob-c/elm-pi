{
  "defaultProjectTrust": "never",
  "defaultProvider": "elm",
  "defaultModel": "@QWEN_MODEL@",
  "defaultThinkingLevel": "off",
  "theme": "dark",
  "quietStartup": false,
  "modelThinkingLevels": {
    "elm/@QWEN_MODEL@": "off"
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-hashline-edit-pro",
    "npm:@gotgenes/pi-permission-system",
    "npm:@henryqw/pi-task-models",
    "npm:@henryqw/pi-auto-compact",
    "npm:@tmustier/pi-ralph-wiggum",
    "npm:@pify/btw",
    "npm:awesome-pi-themes",
    "npm:cc-safety-net",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@quintinshaw/pi-dynamic-workflows"
  ],
  "extensions": [
    "${PI_CODING_AGENT_DIR}/extensions"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "sessionDir": ".pi/sessions",
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "elm-shim/@LLAMA_MODEL@"
      },
      "oracle": {
        "model": "elm/@QWEN_MODEL@"
      },
      "researcher": {
        "model": "elm/@QWEN_MODEL@"
      },
      "reviewer": {
        "model": "elm/@QWEN_MODEL@"
      },
      "scout": {
        "model": "elm/@QWEN_MODEL@"
      },
      "worker": {
        "model": "elm/@QWEN_MODEL@"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "elm/*",
        "elm-shim/*",
        "inherit"
      ]
    },
    "disableThinking": true
  },
  "compaction": {
    "enabled": false
  }
}
