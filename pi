#!/usr/bin/env bash
# pi - the launcher an install runs, and now only a hand-over.
#
# The launcher itself is python/elmpi (see python/README.md): the ELM-only
# policy, the environment pi starts with, which extensions load, where a
# session may start and what reaches the network are decided there, in modules
# that can be read and tested one at a time. python/pi starts that Python in a
# clean room - no PYTHON* variable, no site-packages, no import from anywhere
# but this install's own package and the stdlib - and everything this file
# does is find the install and hand over.
#
# The installer links this path into ~/.local/bin and agent/bin; its small path
# resolver remains shell so the hand-over can be checked by eye.
# The previous implementation is pi.bash beside it: unchanged apart from
# naming itself, not installed, and run by tests/test_python_launcher.py
# against this one so the two are held to the same decisions.
set -eu
unset CDPATH

# Resolve through symlinks: the installer links ~/.local/bin/pi -> here, and
# that link may itself be a link, so target/.. is not the install unless every
# link on the way is real.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$LINK_DIR/$SELF" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"

if [ ! -f "$HERE/python/pi" ]; then
  echo "pi: the launcher is missing: $HERE/python/pi. Run $HERE/bootstrap.sh." >&2
  exit 1
fi
if [ ! -x "$HERE/python/pi" ]; then   # lost its mode: bash's own "Permission denied" names no fix
  echo "pi: the launcher is not executable: $HERE/python/pi. Run: chmod +x $HERE/python/pi" >&2
  exit 1
fi

# exec, so no second process is left behind and python/pi's exit code, signals
# and terminal are this file's.
exec "$HERE/python/pi" "$@"
